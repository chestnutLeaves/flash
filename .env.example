# Flash configuration. Copy to .env; docker compose reads it as-is, and a
# bare binary takes the same variables from its environment.

# The public origin browsers see. Passkeys, OAuth and mailed links are
# minted against it, so it must match exactly (scheme, host, port).
FLASH_BASE_URL=https://cards.example.com

# Moved to a new FLASH_BASE_URL? List the old origins here, comma-separated.
# An assistant connected before the move keeps naming the old origin's
# /mcp when it signs in, and would otherwise be refused (invalid_target).
#FLASH_PREVIOUS_BASE_URLS=https://old-cards.example.com

# Listen address. The Docker image binds 0.0.0.0 inside the container;
# outside Docker the default is 127.0.0.1:8437.
#FLASH_BIND=0.0.0.0:8437

# Where the SQLite database, import scratch space and media live
# (/data in the Docker image). Back it up.
#FLASH_DATA_DIR=/data

# Behind a reverse proxy, the header that carries the real client address
# (rate limiting keys on it; without it every visitor shares one bucket
# and the server warns at boot). x-real-ip for Caddy/nginx once they
# set it, cf-connecting-ip for Cloudflare, x-forwarded-for if that is
# what you have (the rightmost address is used). Leave unset if clients
# connect directly, and set it only when nothing but the proxy can reach
# the port.
#FLASH_CLIENT_IP_HEADER=x-real-ip

# One log line per request (method, route template, status, time, client
# address, browser). Paths' values and query strings are never logged.
#FLASH_ACCESS_LOG=1

# Printed on the pages that show a contact address.
#FLASH_SUPPORT_EMAIL=you@example.com

# Languages readers may be given besides English, comma-separated: Spanish
# as Spain writes it (es-ES) and as Latin America does (es-419), Portuguese
# as Brazil (pt-BR) and Portugal (pt-PT) write it, and French as France
# (fr-FR) and Canada (fr-CA) do. Unset gives English only. Each reader gets
# the one they chose, else what their browser, assistant or phone asks for.
#FLASH_LANGUAGES=es-ES,es-419,pt-BR,pt-PT,fr-FR,fr-CA

# Outbound mail through Resend, which enables password reset. Both or
# neither. For a local trial, FLASH_DEV_MAIL_LOG=1 logs the mail instead.
#RESEND_API_KEY=re_...
#FLASH_EMAIL_FROM=Flash <flash@example.com>
#FLASH_DEV_MAIL_LOG=1

# Media blobs in any S3-compatible bucket (S3, R2, MinIO, B2) instead of
# under the data directory. Most installs leave this unset. All four or
# none.
#FLASH_MEDIA_R2_ENDPOINT=https://<s3-endpoint>
#FLASH_MEDIA_R2_BUCKET=<bucket>
#FLASH_MEDIA_R2_ACCESS_KEY_ID=
#FLASH_MEDIA_R2_SECRET_ACCESS_KEY=
