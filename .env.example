# Flash configuration. Copy to .env; docker compose reads it as-is, and a
# bare binary takes the same variables from its environment.

# The public origin browsers see. Passkeys, OAuth and mailed links are
# minted against it, so it must match exactly (scheme, host, port).
FLASH_BASE_URL=https://cards.example.com

# Listen address. The Docker image binds 0.0.0.0 inside the container;
# outside Docker the default is 127.0.0.1:8437.
#FLASH_BIND=0.0.0.0:8437

# Where the SQLite database, import scratch space and media live
# (/data in the Docker image). Back it up.
#FLASH_DATA_DIR=/data

# Behind a reverse proxy, the header that carries the real client address
# (rate limiting keys on it; without it every visitor shares one bucket
# and the server warns at boot). x-real-ip for Caddy/nginx once they
# set it, cf-connecting-ip for Cloudflare, x-forwarded-for if that is
# what you have (the rightmost address is used). Leave unset if clients
# connect directly, and set it only when nothing but the proxy can reach
# the port.
#FLASH_CLIENT_IP_HEADER=x-real-ip

# Printed on the pages that show a contact address.
#FLASH_SUPPORT_EMAIL=you@example.com

# Outbound mail through Resend, which enables password reset. Both or
# neither. For a local trial, FLASH_DEV_MAIL_LOG=1 logs the mail instead.
#RESEND_API_KEY=re_...
#FLASH_EMAIL_FROM=Flash <flash@example.com>
#FLASH_DEV_MAIL_LOG=1

# Media blobs in any S3-compatible bucket (S3, R2, MinIO, B2) instead of
# under the data directory. Most installs leave this unset. All four or
# none.
#FLASH_MEDIA_R2_ENDPOINT=https://<s3-endpoint>
#FLASH_MEDIA_R2_BUCKET=<bucket>
#FLASH_MEDIA_R2_ACCESS_KEY_ID=
#FLASH_MEDIA_R2_SECRET_ACCESS_KEY=

# Card generation and spoken-answer grading through a model API with your
# own key. Unset, the app has no Generate button, study is unchanged and
# nothing is ever sent out. `openai` is any endpoint speaking the OpenAI
# Chat Completions protocol (text, photos, recordings), hosted or on this
# machine; `gemini` is the native adapter, the one that also reads PDFs,
# video and YouTube links. The README's "Using your own model" lists the
# settings for the popular endpoints.
#FLASH_AI_PROVIDER=openai
# The key, for either provider. With `openai` an empty value is allowed
# for a local endpoint that needs none.
#FLASH_AI_API_KEY=
# `openai` only: the endpoint's base; /chat/completions is appended.
#FLASH_AI_BASE_URL=https://host/v1
# The model that reads sources and writes cards, and the one that grades
# spoken answers. Required for `openai`, as the endpoint names it (the
# grader defaults to the model); `gemini` has its own defaults. Every
# call is recorded with the provider's own token counts.
#FLASH_AI_MODEL=
#FLASH_AI_GRADER_MODEL=
# `openai` only: how the reply's shape is asked for. `schema` sends the
# JSON Schema in strict mode; `json` asks for a JSON object and states
# the schema in the prompt; `plain` sends no response_format at all.
#FLASH_AI_OUTPUT=schema
# What a spoken answer is graded from: `transcript`, the phone's or
# browser's own speech recognition (free), or `audio`, the recording
# itself, which the grader listens to (right on specialised terms and
# other languages, a fraction of a cent per card).
#FLASH_VOICE_INPUT=transcript
# Unset, users may generate from everything the model reads (video and
# audio included; mind what your key's plan charges). A comma list of
# text,pdf,image,youtube,video,audio narrows it.
#FLASH_AI_INPUTS=text,pdf,image
# PDFs need the Pdfium shared library (the Docker image ships it):
# `tools/fetch-pdfium.sh` (or .ps1) downloads it into ./data/pdfium and
# prints this line. A file or the directory holding it.
#FLASH_PDFIUM_PATH=./data/pdfium
# Word, PowerPoint and spreadsheet files are converted to PDF by a
# command of your choosing, given the file as {input} and the directory
# the PDF must land in as {outdir}. Unset, those files are refused.
#FLASH_DOC_CONVERTER=soffice --headless --convert-to pdf --outdir {outdir} {input}
#FLASH_DOC_CONVERTER_TIMEOUT_SECS=120

# Natural voice for study: the sidecar in tools/flash-tts reads each card
# in one of 41 voices, a few cards ahead of the queue. Unset, study uses
# the device's own voice. `docker compose --profile voice up -d` starts
# it at the address below; outside Docker see tools/flash-tts/README.md.
#FLASH_TTS_URL=http://flash-tts:8880
# The voice new accounts start with (an id from tools/flash-tts/flash_tts/voices.py).
#FLASH_TTS_VOICE_DEFAULT=af_heart
