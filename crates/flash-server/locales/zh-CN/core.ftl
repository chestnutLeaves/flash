### The open core's words in English. Every message has a note above it:
### where it shows, who reads it, and what each variable holds.

## The language picker

# The picker's label, in Settings and on the sign-in page.
language = 语言
# The picker's first choice: the language the browser, the assistant or
# the phone asks for, whichever spoke last.
language-automatic = 自动
# A link at the top of an English public page offering the same page in
# the visitor's language; shown in that language ("Ver en español").
language-offer = 查看英文版

## Failures every page can show

# Shown when something failed on Flash's side; the detail goes to the
# server's log, never to the reader.
error-internal = 内部错误
# Shown when a page could not be drawn; the detail goes to the log.
error-render = 渲染错误
# Shown when something being added already exists (a deck or tag of the
# same name).
error-exists = 已经存在

## How long ago something happened (lists of decks, devices, users)

# Something that happened in the last minute.
when-just-now = 现在
# Minutes ago, short. $count is the number of minutes (1 to 59).
when-minutes-ago = { $count } 分钟前
# Hours ago, short. $count is the number of hours (1 to 23).
when-hours-ago = { $count } 小时前
# Days ago, short. $count is the number of days (1 to 29).
when-days-ago = { $count } 天前

## Words many pages share

# Spoken name and tooltip of a dialog's close button (an X).
close = 关闭
