### Portuguese as Portugal words it, where it differs from the shared base (pt): panel.

## O cabeçalho

panel-expand-title = Mostrar este cartão em ecrã inteiro
panel-expand-label = Expandir: mostrar este cartão em ecrã inteiro

## Estudar

panel-loading = A carregar os seus cartões…
panel-again = Errei
panel-undo = Anular

## Editar um cartão no painel

panel-save = Guardar
panel-save-failed = Não foi possível guardar o cartão. Tente novamente.

## Uma sessão concluída

panel-empty-text = Peça cartões a partir dos seus apontamentos, de um documento ou de um tema, e estude-os aqui.
panel-nothing-due = Nada a rever agora.
panel-cards-reviewed =
    { $count ->
        [one] { $count } cartão revisto
        [many] { $count } de cartões revistos
       *[other] { $count } cartões revistos
    }
panel-score-again = { $count } errei
panel-next-tomorrow =
    { $count ->
        [0] Cartões a rever amanhã
        [one] { $count } cartão a rever amanhã
        [many] { $count } de cartões a rever amanhã
       *[other] { $count } cartões a rever amanhã
    }
panel-next-weekday =
    { $count ->
        [0] Cartões a rever: { $day }
        [one] { $count } cartão a rever: { $day }
        [many] { $count } de cartões a rever: { $day }
       *[other] { $count } cartões a rever: { $day }
    }
panel-next-days =
    { $count ->
        [0] Cartões a rever daqui a { $days } dias
        [one] { $count } cartão a rever daqui a { $days } dias
        [many] { $count } de cartões a rever daqui a { $days } dias
       *[other] { $count } cartões a rever daqui a { $days } dias
    }
panel-remind-title = Enviar um email quando houver cartões a rever
panel-remind-fallback = Pode ativar os lembretes nas definições do Flash.
panel-progress = Ver o seu progresso
panel-ask-deck = Ajude-me a criar cartões para { $deck }.
panel-ask-tags = Ajude-me a criar cartões com as etiquetas { $tags }.
panel-ask-first = Ajude-me a criar os meus primeiros cartões.

## Os cartões que acabaram de ser criados ou editados

panel-next = Cartão seguinte
