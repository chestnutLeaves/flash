### The open core's words in Portuguese, both variants: stats.

## Estatísticas

stats-title = Estatísticas - Flash
stats-heading = Estatísticas
stats-reviews-30 = revisões, últimos 30 dias
stats-retention = retenção, últimos 30 dias
stats-reviews-all = revisões, desde o início
stats-streak = dias seguidos
stats-longest = maior sequência
stats-mature = cartões maduros (dos ativos)
stats-percent = { $n }%
stats-past-year = Último ano
stats-years = Ano do mapa de calor
stats-cell-due = { $day }: { $count } a revisar
stats-cell-reviews =
    { $count ->
        [one] { $day }: { $count } revisão
        [many] { $day }: { $count } de revisões
       *[other] { $day }: { $count } revisões
    }
stats-legend-avg-html =
    { $count ->
        [one] Média diária: <span>{ $count } revisão</span>
        [many] Média diária: <span>{ $count } de revisões</span>
       *[other] Média diária: <span>{ $count } revisões</span>
    }
stats-legend-learned-html = Dias de estudo: <span>{ $pct }%</span>
stats-legend-longest-html =
    { $count ->
        [one] Maior sequência: <span>{ $count } dia</span>
        [many] Maior sequência: <span>{ $count } de dias</span>
       *[other] Maior sequência: <span>{ $count } dias</span>
    }
stats-legend-current-html =
    { $count ->
        [one] Sequência atual: <span>{ $count } dia</span>
        [many] Sequência atual: <span>{ $count } de dias</span>
       *[other] Sequência atual: <span>{ $count } dias</span>
    }
stats-per-day = Revisões por dia
stats-coming-up = Próximos dias
stats-col-day = Dia
stats-col-due = Cartões a revisar
stats-today = Hoje

